/*
    PR-gate config: point annotation at the mini databases in tests/data/db/.
    Include it from a test with `config "./pr.config"` (path relative to the test file).
    kofam/ is built by `tests/scripts/build_mini_dbs.py kofam` (not committed).
*/

params {
    kofam_db            = "${projectDir}/tests/data/db/kofam/"
    kofam_list          = "${projectDir}/tests/data/db/kofam/kofam_ko_list.tsv"
    vog_db              = "${projectDir}/tests/data/db/vogdb/"
    fegenie_db          = "${projectDir}/tests/data/db/fegenie/"
    camper_hmm_db       = "${projectDir}/tests/data/db/camper_hmm/"
    camper_hmm_list     = "${projectDir}/tests/data/db/camper_hmm/camper_hmm_scores.tsv"
    camper_mmseqs_db    = "${projectDir}/tests/data/db/camper_mmseqs/"
    camper_mmseqs_list  = "${projectDir}/tests/data/db/camper_mmseqs/camper_scores.tsv"
    canthyd_hmm_db      = "${projectDir}/tests/data/db/canthyd_hmm/"
    cant_hyd_hmm_list   = "${projectDir}/tests/data/db/canthyd_hmm/cant_hyd_HMM_scores.tsv"
    canthyd_mmseqs_db   = "${projectDir}/tests/data/db/canthyd_mmseqs/"
    canthyd_mmseqs_list = "${projectDir}/tests/data/db/canthyd_mmseqs/cant_hyd_BLAST_scores.tsv"
    dram_db             = "${projectDir}/tests/data/db/dram_db/dram_db.hmm"
    dram_db_list        = "${projectDir}/tests/data/db/dram_db/dram_db_scores.tsv"
    uniref_db           = "${projectDir}/tests/data/db/uniref/"
}

// GitHub's ubuntu-latest runner has 4 CPUs and 16 GB; cap requests to fit it
process {
    resourceLimits = [cpus: 4, memory: 14.GB, time: 1.h]
}
