nextflow_pipeline {

    name "Test summarize"
    script "../main.nf"
    tag "full"

    test("Test SUMMARIZE") {

        when {
            params {
                outdir = "$outputDir"
                summarize = true
                qc = true
            }
        }


        then {
            assert workflow.success
            // Gene Count values are checked in the PR tier (owc_pr, refine_values)
            assert path("${params.outdir}/SUMMARIZE/topic_summary.tsv").exists()
        }
    }

    test("Test SUMMARIZE with supplied annotations") {

        when {
            params {
                outdir = "$outputDir"
                input_fasta = null
                rename = false
                annotate = false
                qc = false
                summarize = true
                anno_dbs = ""
                annotations = "${projectDir}/tests/data/owc/annotation/dram1_informed_annotations.tsv"
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/SUMMARIZE/topic_summary.tsv").exists()
        }
    }

    test("Test SUMMARIZE with supplied annotations and QC tables") {

        when {
            params {
                outdir = "$outputDir"
                input_fasta = null
                rename = false
                annotate = false
                qc = true
                summarize = true
                anno_dbs = ""
                annotations = "${projectDir}/tests/data/owc/annotation/dram1_informed_annotations.tsv"
                rrnas = "${projectDir}/tests/data/owc/qc/rrnas"
                trnas = "${projectDir}/tests/data/owc/qc/trnas"
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/SUMMARIZE/topic_summary.tsv").exists()
            assert path("${params.outdir}/ANNOTATE/raw_rrna_scan.tsv").exists()
            assert path("${params.outdir}/ANNOTATE/raw_trna_scan.tsv").exists()
        }
    }

    test("Test QC retains bin quality without taxonomy") {

        when {
            params {
                outdir = "$outputDir"
                input_fasta = null
                rename = false
                annotate = false
                qc = true
                summarize = false
                anno_dbs = ""
                annotations = "${projectDir}/tests/data/owc/annotation/dram1_informed_annotations.tsv"
                bin_quality = "${projectDir}/tests/data/owc/qc/bin_quality.tsv"
            }
        }

        then {
            assert workflow.success
            def actual = path("${params.outdir}/ANNOTATE/raw-annotations.tsv").csv(sep: "\t")
            assert actual.columns["Completeness"].every { it == 98.5 || it == 91.0 }
            assert actual.columns["Contamination"].every { it == 1.2 || it == 2.5 }
        }
    }
}
