nextflow_function {

    name "Test resource class helpers"
    script "subworkflows/local/utils_resource_classes.nf"
    tag "resource_classes"

    test("200 MiB is small") {
        function "resourceClass"
        when {
            function {
                """
                input[0] = 200L * 1024L * 1024L
                """
            }
        }
        then {
            assert function.success
            assert function.result == "small"
        }
    }

    test("More than 200 MiB is medium") {
        function "resourceClass"
        when {
            function {
                """
                input[0] = (200L * 1024L * 1024L) + 1L
                """
            }
        }
        then {
            assert function.success
            assert function.result == "medium"
        }
    }

    test("1 GiB is medium") {
        function "resourceClass"
        when {
            function {
                """
                input[0] = 1024L * 1024L * 1024L
                """
            }
        }
        then {
            assert function.success
            assert function.result == "medium"
        }
    }

    test("More than 1 GiB is large") {
        function "resourceClass"
        when {
            function {
                """
                input[0] = (1024L * 1024L * 1024L) + 1L
                """
            }
        }
        then {
            assert function.success
            assert function.result == "large"
        }
    }

    test("Custom small threshold") {
        function "resourceClass"
        when {
            params {
                resource_class_small_max_size = '100.MB'
                resource_class_medium_max_size = '500.MB'
            }
            function {
                """
                input[0] = 100L * 1024L * 1024L
                """
            }
        }
        then {
            assert function.success
            assert function.result == "small"
        }
    }

    test("Custom medium threshold") {
        function "resourceClass"
        when {
            params {
                resource_class_small_max_size = '100.MB'
                resource_class_medium_max_size = '500.MB'
            }
            function {
                """
                input[0] = 500L * 1024L * 1024L
                """
            }
        }
        then {
            assert function.success
            assert function.result == "medium"
        }
    }

    test("Custom large threshold") {
        function "resourceClass"
        when {
            params {
                resource_class_small_max_size = '100.MB'
                resource_class_medium_max_size = '500.MB'
            }
            function {
                """
                input[0] = (500L * 1024L * 1024L) + 1L
                """
            }
        }
        then {
            assert function.success
            assert function.result == "large"
        }
    }

    test("Reject equal thresholds") {
        function "resourceClass"
        when {
            params {
                resource_class_small_max_size = '1.GB'
                resource_class_medium_max_size = '1.GB'
            }
            function {
                """
                input[0] = 1L
                """
            }
        }
        then {
            assert !function.success
            assert function.stdout.join("\n").contains('Resource class thresholds must be positive')
        }
    }

    test("Reject zero threshold") {
        function "resourceClass"
        when {
            params {
                resource_class_small_max_size = '0.B'
            }
            function {
                """
                input[0] = 1L
                """
            }
        }
        then {
            assert !function.success
            assert function.stdout.join("\n").contains('Resource class thresholds must be positive')
        }
    }

    test("Count one file") {
        function "resourceBytes"
        when {
            function {
                """
                input[0] = file("${projectDir}/subworkflows/local/tests/fixtures/flat.txt")
                """
            }
        }
        then {
            assert function.success
            assert function.result == 5L
        }
    }

    test("Count a path collection") {
        function "resourceBytes"
        when {
            function {
                """
                input[0] = [
                    file("${projectDir}/subworkflows/local/tests/fixtures/flat.txt"),
                    file("${projectDir}/subworkflows/local/tests/fixtures/nested/nested.txt")
                ]
                """
            }
        }
        then {
            assert function.success
            assert function.result == 12L
        }
    }

    test("Count a directory recursively") {
        function "resourceBytes"
        when {
            function {
                """
                input[0] = file("${projectDir}/subworkflows/local/tests/fixtures")
                """
            }
        }
        then {
            assert function.success
            assert function.result == 12L
        }
    }
}
