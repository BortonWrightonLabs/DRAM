params {
    max_memory = '64.GB'
    max_cpus = 16
    max_time = '24.h'
}

executor {
    queueSize = 16
    pollInterval = '1 min'
    queueStatInterval = '5 min'
    submitRateLimit = '10 sec'
}

process {
    executor = 'slurm'
    queue = 'cpu_partition'
    clusterOptions = '--account=my_account --qos=cpu_qos'

    withLabel: 'process_gpu' {
        cpus = 4
        queue = 'gpu_partition'
        clusterOptions = '--account=my_account --gres=gpu:1 --qos=gpu_qos --nodes=1'
    }
}
